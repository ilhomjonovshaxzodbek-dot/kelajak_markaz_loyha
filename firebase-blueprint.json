{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public-safe user profile without PII for Kelajak Markazi members.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Display name of the user",
          "minLength": 1,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "description": "User role in Kelajak Markazi",
          "enum": ["admin", "administrator", "teacher", "student"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": ["uid", "displayName", "role", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII document for user email and phone number.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "phone": {
          "type": "string",
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "createdAt", "updatedAt"]
    },
    "StaffRole": {
      "title": "StaffRole",
      "description": "Trusted RBAC role assignment document managed strictly by Super Admin.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "enum": ["admin", "administrator", "teacher", "student"]
        },
        "assignedBy": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "role", "assignedBy", "createdAt", "updatedAt"]
    },
    "CenterPublicCatalog": {
      "title": "CenterPublicCatalog",
      "description": "Public-safe non-PII catalog of courses, groups, rewards, Telegram communities, quizzes, and issued certificate summaries.",
      "type": "object",
      "properties": {
        "courses": { "type": "array" },
        "groups": { "type": "array" },
        "rewards": { "type": "array" },
        "telegramCommunities": { "type": "array" },
        "quizzes": { "type": "array" },
        "certificates": { "type": "array" },
        "contactInfo": {
          "type": "object",
          "description": "Admin-editable campus phone numbers, working hours, address, and contact description."
        },
        "updatedBy": {
          "type": "string",
          "maxLength": 128
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["courses", "groups", "rewards", "telegramCommunities", "quizzes", "certificates", "updatedBy", "updatedAt"]
    },
    "CenterOperationsState": {
      "title": "CenterOperationsState",
      "description": "Staff-only operational snapshot containing teachers, students, homework, submissions, payments, quiz attempts, reward orders, and notifications.",
      "type": "object",
      "properties": {
        "teachers": { "type": "array" },
        "students": { "type": "array" },
        "homeworkTasks": { "type": "array" },
        "submissions": { "type": "array" },
        "registrations": { "type": "array" },
        "notifications": { "type": "array" },
        "payments": { "type": "array" },
        "quizAttempts": { "type": "array" },
        "rewardOrders": { "type": "array" },
        "updatedBy": {
          "type": "string",
          "maxLength": 128
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["teachers", "students", "homeworkTasks", "submissions", "registrations", "notifications", "payments", "quizAttempts", "rewardOrders", "updatedBy", "updatedAt"]
    },
    "TrialLead": {
      "title": "TrialLead",
      "description": "Public trial lesson registration lead readable only by Admins and Administrators.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "phone": { "type": "string", "minLength": 4, "maxLength": 40 },
        "courseTitle": { "type": "string", "minLength": 1, "maxLength": 160 },
        "preferredTime": { "type": "string", "minLength": 1, "maxLength": 80 },
        "status": { "type": "string", "enum": ["new", "confirmed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fullName", "phone", "courseTitle", "preferredTime", "status", "createdAt"]
    },
    "StudentLink": {
      "title": "StudentLink",
      "description": "Links an authenticated Firebase user UID to their student record ID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "studentName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "studentId", "studentName", "updatedAt"]
    },
    "TestConnection": {
      "title": "TestConnection",
      "description": "Startup Firestore connection check document.",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "maxLength": 40
        }
      },
      "required": ["status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Public-safe user profile documents."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "PII-isolated private contact information for a user."
    },
    "/staff_roles/{userId}": {
      "schema": { "$ref": "#/entities/StaffRole" },
      "description": "Trusted RBAC role registry for admin, administrator, teacher, and student access."
    },
    "/center_public/{docId}": {
      "schema": { "$ref": "#/entities/CenterPublicCatalog" },
      "description": "Public catalog for Kelajak Markazi courses, groups, rewards, communities, quizzes, and verified certificates."
    },
    "/center_ops/{docId}": {
      "schema": { "$ref": "#/entities/CenterOperationsState" },
      "description": "Staff-only operational snapshot for students, payments, homework, and registrations."
    },
    "/trial_leads/{leadId}": {
      "schema": { "$ref": "#/entities/TrialLead" },
      "description": "Submitted trial lesson leads with PII restricted to administrators."
    },
    "/student_links/{userId}": {
      "schema": { "$ref": "#/entities/StudentLink" },
      "description": "Student account-to-profile linking documents."
    },
    "/test/{docId}": {
      "schema": { "$ref": "#/entities/TestConnection" },
      "description": "Connection verification document."
    }
  }
}
